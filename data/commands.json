        "example": "Get-ChildItem Env:"
      }
    },
    {
      "cmd": "export",
      "desc": "Set an environment variable.",
      "example": "export VAR=\"value\"",
      "cat": "System",
      "step": 6,
      "win": {
        "cmd": "$env:VAR = (setx)",
        "desc": "Set an environment variable in PowerShell.",
        "example": "$env:VAR = \"value\""
      }
    },
