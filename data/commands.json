      "cat": "Network",
      "step": 8,
      "win": {
        "cmd": "Invoke-WebRequest -OutFile",
        "desc": "Download and save a file in PowerShell.",
        "example": "Invoke-WebRequest https://example.com/file.zip -OutFile file.zip"
      }
    },
